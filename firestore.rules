rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPERS
    // ============================================

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    /**
     * Lee el rol desde CUSTOM CLAIMS del token (más seguro que leer
     * el documento users/{uid}, que puede tener race conditions).
     *
     * Los custom claims se asignan via:
     *   firebase auth:export-users
     *   admin.auth().setCustomUserClaims(uid, { role: 'admin' })
     *
     * Ver scripts/create-first-admin.mjs
     */
    function userRole() {
      return isAuth() && request.auth.token.role != null
        ? request.auth.token.role
        : '';
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    function isInspector() {
      return userRole() == 'inspector' || isAdmin();
    }

    function isSeller() {
      return userRole() == 'seller' || isAdmin();
    }

    function isIn(uid, list) {
      return uid in list;
    }

    // Field validation helpers
    function hasFields(data, fields) {
      return fields.all(f => f in data);
    }

    function isString(val) {
      return val is string;
    }

    function isNumber(val) {
      return val is number;
    }

    function isBool(val) {
      return val is bool;
    }

    function isTimestamp(val) {
      return val is timestamp;
    }

    // ============================================
    // USERS
    // ============================================
    match /users/{userId} {
      // Lectura: owner + inspectors + sellers (para verificar DNI al cobrar)
      allow read: if isOwner(userId) || isInspector() || isSeller();

      // Crear: solo el propio usuario, con campos mínimos requeridos
      allow create: if request.auth.uid == userId
        && request.resource.data.keys().hasAll(['name', 'email'])
        && request.resource.data.name is string
        && request.resource.data.email is string;

      // Update: el owner puede modificar SU perfil EXCEPTO role y balance
      //          el admin puede modificar todo (incluyendo role/balance de otros)
      // FIX bug 0.6: la precedence original `isOwner(userId) || isAdmin() && (...)`
      //                era ambigua y permitía al owner mutar role/balance. Ahora:
      //                  - owner: puede modificar todo MENOS role/balance
      //                  - admin: puede modificar todo
      allow update: if isAdmin()
        || (isOwner(userId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'balance']));

      allow delete: if isAdmin();
      allow list: if isInspector() || isSeller();
    }

    // ============================================
    // PUBLIC DATA (settings, zones, special days)
    // ============================================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /zones/{zoneId} {
      allow read: if true;
      // FIX bug 0.6: requisitos actualizados para coincidir con Zone interface
      //   (id, name, active, center, radius, description, tariff opcional)
      allow write: if isAdmin()
        && request.resource.data.keys().hasAll(['name', 'center', 'radius', 'active'])
        && request.resource.data.name is string
        && request.resource.data.center.lat is number
        && request.resource.data.center.lng is number
        && request.resource.data.radius is number
        && request.resource.data.active is bool;
    }

    match /special_days/{dayId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasAll(['date', 'type', 'name'])
        && request.resource.data.date is string
        && request.resource.data.type is string;
    }

    // ============================================
    // VEHICLES
    // ============================================
    match /vehicles/{vehicleId} {
      allow read: if isOwner(resource.data.userId) || isInspector() || isSeller();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['licensePlate', 'userId'])
        && request.resource.data.licensePlate is string;
      allow update: if isOwner(resource.data.userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId']));
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ============================================
    // PARKING SESSIONS
    // ============================================
    match /parking_sessions/{sessionId} {
      allow read: if isOwner(resource.data.userId) || isInspector() || isSeller();
      allow create: if isAuth()
        && (
          // Owner creates for themselves
          (request.resource.data.userId == request.auth.uid
            && request.resource.data.keys().hasAll(['userId', 'zone', 'startTime', 'endTime', 'status'])
            && request.resource.data.status == 'active'
            && request.resource.data.startTime is timestamp
            && request.resource.data.endTime is timestamp)
          ||
          // Seller creates for any user (server-side validated)
          (isSeller()
            && request.resource.data.keys().hasAll(['userId', 'zone', 'startTime', 'endTime', 'status', 'vehiclePlate'])
            && request.resource.data.status == 'active')
        );
      allow update: if isOwner(resource.data.userId) || isInspector()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endTime', 'status', 'cost', 'extendedAt']);
      allow delete: if false; // Never delete parking sessions
    }

    // ============================================
    // FINES
    // ============================================
    match /fines/{fineId} {
      allow read: if isOwner(resource.data.userId) || isInspector();
      allow create: if isInspector()
        && request.resource.data.keys().hasAll(['userId', 'vehiclePlate', 'amount', 'status', 'zone', 'type', 'inspectorId'])
        && request.resource.data.amount is number
        && request.resource.data.vehiclePlate is string
        && request.resource.data.status == 'pending'
        && request.resource.data.inspectorId == request.auth.uid;
      // FIX bug 0.6: agrupamiento correcto con paréntesis.
      //                Original era ambiguo: `isOwner || isInspector || isAdmin`
      //                pero el orden de || y && sin paréntesis causa bugs.
      //                Ahora es explícito:
      //                  - owner puede cambiar solo status/paidAt (pagar)
      //                  - inspector puede cambiar más campos (ajustar multa)
      //                  - admin puede cambiar todo
      allow update: if isAdmin()
        || (isOwner(resource.data.userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt']))
        || (isInspector()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'paidAt', 'amount', 'description', 'cancelledAt']));
      allow delete: if isAdmin();
    }

    // ============================================
    // FINANCIAL
    // ============================================
    match /transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // FIX bug 0.6: solo server puede crear (vía Cloud Function / API route)
      //                Original permitía al user crear con cualquier userId, riesgo
      //                de fraude (crear transactions con amount positivo).
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /payments/{paymentId} {
      // FIX bug 0.6: payments se pueden leer solo por owner o admin.
      //                Guest payments: el owner es null, no se permite lectura pública.
      allow read: if isOwner(resource.data.userId) || isAdmin();
      // Solo server puede crear (vía webhook Macro Click)
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /movements/{movementId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ============================================
    // NOTIFICATIONS
    // ============================================
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAdmin(); // System creates
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /notifications_queue/{notificationId} {
      allow read, write: if isAdmin();
    }

    // ============================================
    // AUDIT & INSPECTOR ACTIVITY
    // ============================================
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      // FIX bug 0.6: solo server puede crear audit logs (no se aceptan del cliente)
      allow create: if isAdmin();
      allow delete: if false;
    }

    match /inspector_activity/{activityId} {
      allow read: if isInspector();
      allow create: if isInspector()
        && request.resource.data.keys().hasAll(['inspectorId', 'type', 'timestamp'])
        && request.resource.data.inspectorId == request.auth.uid;
      allow delete: if false;
    }

    // ============================================
    // SELLER TRANSACTIONS
    // ============================================
    match /seller_transactions/{txId} {
      allow read: if isSeller() || isAdmin();
      allow create: if isSeller() || isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ============================================
    // ⚠️ REMOVED: ADMIN WILDCARD
    // ============================================
    // Antes había un `match /{document=**} { allow read, write: if isAdmin(); }`
    // que exponía TODA la base de datos a cualquier token admin comprometido.
    // Fue removido en la fix 0.6. Si necesitás acceso a una nueva colección
    // desde el admin, agregá una regla EXPLÍCITA para esa colección.
  }
}
