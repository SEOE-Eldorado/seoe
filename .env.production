# ============================================
# SEOE Wallet - Producción
# ============================================
# Copiar a .env.production.local y ajustar

# App mode: vacío = wallet | inspector = modo fiscalización
NEXT_PUBLIC_APP_ENV=

# Firebase: conectar a producción (NO emuladores)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# FCM VAPID Key (obligatorio para push notifications)
# Generar en: Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_FCM_VAPID_KEY=

# App Check: reCAPTCHA Enterprise Site Key (opcional pero recomendado)
# Obtener en: Firebase Console > App Check > reCAPTCHA Enterprise
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Sentry (opcional)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=seoe
SENTRY_PROJECT=javascript-nextjs

# Firebase Admin SDK (para Cloud Functions y seed)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
